# ---------------------------------------------------------------------------
# Train Console settings (copy this file to .env and edit)
# ---------------------------------------------------------------------------

# CVAT API (server). This is the FastAPI/Django API port, not the UI proxy.
TC_CVAT_URL=http://localhost:51102
# CVAT UI URL that users open (your existing CVAT)
TC_CVAT_UI_URL=http://localhost:8081
# Port used by run_console.sh
TC_CONSOLE_PORT=9080

# CVAT admin account used by the console
TC_CVAT_USERNAME=admin
TC_CVAT_PASSWORD=change-me
# Docker container name of the CVAT server, used to reset labeler passwords
TC_CVAT_CONTAINER=cvat_server

# Train Console login
TC_ADMIN_USERNAME=admin
TC_ADMIN_PASSWORD=admin
TC_SECRET_KEY=change-me-please

# Storage
TC_DATABASE_URL=sqlite:///./var/trainconsole.db
TC_DATA_ROOT=./data
TC_ARTIFACT_ROOT=./var/trainconsole

# Default pool: every image below this folder can be sampled into a batch
TC_POOL_ROOT=./data/pool
TC_LABELS="head,shoulder,hand,seatbelt,cell phone,cigarette"
# Labels that are masks and must not be trained as YOLO boxes
TC_EXCLUDE_FROM_DETECTION=seatbelt
# CVAT project created/used by default
TC_CVAT_PROJECT="Train Console"

# Training
# GPU: single id, or comma-separated for multi-GPU DDP, e.g. 0,1,3.
# The batch you enter is PER GPU: batch 14 on 3 GPUs = 14 on each GPU.
TC_GPU=3
TC_MODEL=yolo26x.pt
TC_EPOCHS=20
TC_YOLO_BATCH=8
TC_IMGSZ=640
TC_YOLO_WORKERS=2
# Reuse per-job CVAT exports across training runs (only new/changed jobs are
# exported). Set 0 or delete var/trainconsole/job_cache to force a full export.
TC_EXPORT_CACHE=1
# After a successful run, keep only the newest weight per project and delete
# older best.pt / last.pt files. Set 0 to keep every checkpoint.
TC_PRUNE_OLD_WEIGHTS=1
TC_TRAIN_ENV=tanmai
# Python interpreter of the training environment (ultralytics + torch)
TC_TRAIN_PYTHON=/path/to/conda/envs/tanmai/bin/python

# RF-DETR-2XL (requires Python >= 3.10; separate env)
# Used to train RF-DETR and to run the Compare view.
TC_RFDETR_PYTHON=/path/to/rfdetr/env/bin/python
TC_RFDETR_MODEL=RFDETR2XLarge
TC_RFDETR_RESOLUTION=880

# Worker interpreter. Needs requirements-console; for RF-DETR inference it
# must also have ultralytics + rfdetr installed (same env as RF-DETR works).
TC_WORKER_PYTHON=/path/to/rfdetr/env/bin/python

# Inference
TC_CONF=0.25
# YOLO26 is end-to-end (no built-in NMS), the console filters duplicates itself
TC_NMS_IOU=0.5
TC_NMS_CONTAINMENT=0.85
TC_MAX_DET=100
# Seen validation: 20% of the training images
TC_VAL_FRACTION=0.2
